<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/logoLogin"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_button_primary"
                android:contentDescription="Logo de TechStore"
                android:gravity="center"
                android:text="TS"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:text="@string/login_title"
                android:textColor="@color/tech_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/login_subtitle"
                android:textColor="@color/tech_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_28"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electronico"
                android:textColor="@color/tech_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_input"
                android:ems="10"
                android:hint="correo@techstore.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="Contrasena"
                android:textColor="@color/tech_text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_input"
                android:ems="10"
                android:hint="Ingresa tu contrasena"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <CheckBox
                android:id="@+id/checkRememberSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="Recordar mi sesion"
                android:textColor="@color/tech_text_secondary" />

            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_button_primary"
                android:text="Iniciar sesion"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:text="Olvide mi contrasena"
                android:textColor="@color/tech_green_700"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tienes cuenta?"
                android:textColor="@color/tech_text_secondary" />

            <TextView
                android:id="@+id/textGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:clickable="true"
                android:focusable="true"
                android:text="Registrate"
                android:textColor="@color/tech_green_700"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
