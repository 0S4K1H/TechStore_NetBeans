<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            android:id="@+id/logoRegister"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="TS"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/register_title"
            android:textColor="@color/tech_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textColor="@color/tech_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <EditText
                android:id="@+id/inputRegisterName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre completo"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/inputRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_input"
                android:hint="Correo electronico"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/inputRegisterPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_input"
                android:hint="Telefono"
                android:inputType="phone"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/inputRegisterCity"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_input"
                android:hint="Ciudad"
                android:inputType="textCapWords"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/inputRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_input"
                android:hint="Contrasena"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/inputRegisterPasswordConfirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_input"
                android:hint="Confirmar contrasena"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/tech_text_primary"
                android:textColorHint="@color/tech_text_secondary" />

            <CheckBox
                android:id="@+id/checkTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="Acepto terminos y condiciones"
                android:textColor="@color/tech_text_secondary" />

            <Button
                android:id="@+id/buttonCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_button_primary"
                android:text="Crear cuenta"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_20"
            android:clickable="true"
            android:focusable="true"
            android:text="Ya tienes cuenta? Inicia sesion"
            android:textColor="@color/tech_green_700"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
