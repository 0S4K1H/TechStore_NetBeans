  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Inicia sesion como administrador. Postman guarda la cookie JSESSIONID para las siguientes peticiones."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', function () { pm.response.to.have.status(200); });",
                  "var authData = pm.response.json();",
                  "pm.environment.set('adminUserId', authData.idUsuario || authData.id || '');",
                  "pm.test('Rol administrador', function () { pm.expect(String(authData.rol).toLowerCase()).to.include('administrador'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sesion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/session",
            "description": "Valida que la sesion HTTP siga activa despues del login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sesion consultada', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios",
            "description": "Lista usuarios activos. Requiere administrador o empleado."
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ev04_user_{{$timestamp}}\",\n  \"passwordDemo\": \"12345\",\n  \"rol\": \"cliente\",\n  \"nombre\": \"Usuario Evidencia EV04\",\n  \"email\": \"ev04_user_{{$timestamp}}@techstore.demo\",\n  \"ciudad\": \"Armenia\",\n  \"activo\": 1\n}"
            },
            "url": "{{baseUrl}}/usuarios",
            "description": "Crea un usuario. El idUsuario se genera automaticamente en el backend."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuario creado', function () { pm.response.to.have.status(201); });",
                  "var usuarioData = pm.response.json();",
                  "pm.environment.set('usuarioId', usuarioData.idUsuario);",
                  "pm.environment.set('usuarioUsername', usuarioData.username);",
                  "pm.environment.set('usuarioEmail', usuarioData.email);",
                  "pm.test('ID generado automaticamente', function () { pm.expect(usuarioData.idUsuario).to.match(/^USR/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar usuario creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuarioUsername}}\",\n  \"passwordDemo\": \"\",\n  \"rol\": \"cliente\",\n  \"nombre\": \"Usuario Evidencia EV04 Actualizado\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"ciudad\": \"Bogota\",\n  \"activo\": 1\n}"
            },
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Buscar usuario eliminado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/usuarios?q={{usuarioUsername}}",
            "description": "Despues del DELETE el usuario queda inactivo y no debe aparecer en listados activos."
          }
        }
      ]
    },
